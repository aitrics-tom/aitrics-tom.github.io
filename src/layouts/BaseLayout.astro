---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SiteHead from "../components/SiteHead.astro";
import "../styles/global.css";

const {
  title,
  description,
  image,
  type = "website",
  lang = "en",
  pageClass,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <SiteHead title={title} description={description} image={image} type={type} />
  </head>
  <body>
    <div class:list={["page-root", pageClass]}>
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
